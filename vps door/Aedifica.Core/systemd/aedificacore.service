[Unit]
Description=Aedifica.Core local_api (web + SQLite API)
After=network.target

[Service]
Type=simple
User=infinity
WorkingDirectory=/home/infinity/Aedifica.Core/local_api
Environment=LOCAL_API_DATA_DIR=/home/infinity/Aedifica.Core/deploy/data
Environment=LOCAL_API_WEB_DIR=/home/infinity/Aedifica.Core/deploy/web
Environment=LOCAL_API_PORT=84
Environment=LOCAL_API_BIND=127.0.0.1
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/usr/bin/dart run bin/local_api.dart
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
